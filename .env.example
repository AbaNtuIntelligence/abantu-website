DEBUG=True

SECRET_KEY=change-this-development-secret-key

ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=https://abantu-intelligence.co.za,https://www.abantu-intelligence.co.za,https://abantu-website-2mpf.onrender.com,http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/abantu_intelligence

# HMailPlus contact form delivery — Django BACKEND only.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hmailplus.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=info@abantu-intelligence.co.za
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AbaNtu Intelligence <info@abantu-intelligence.co.za>
CONTACT_RECIPIENT_EMAIL=info@abantu-intelligence.co.za
EMAIL_TIMEOUT=15
CONTACT_BURST_RATE=5/minute
CONTACT_SUSTAINED_RATE=20/hour
CONTACT_EMAIL_RATE=5/hour
# Default 0 uses REMOTE_ADDR; see docs/CONTACT-EMAIL.md before changing.
CONTACT_NUM_PROXIES=0
